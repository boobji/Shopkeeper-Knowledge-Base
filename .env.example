# ==========================================================
# 配置模板：复制本文件为 knowledge/.env 后填入你自己的值
#     cp .env.example knowledge/.env
# 注意：knowledge/.env 已被 .gitignore 忽略，不会提交到仓库
# ==========================================================

# ---------- LLM 大模型 ----------
# OpenAI 兼容端点（可填阿里百炼 / DeepSeek / 本地 vLLM 等）
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://your-endpoint/compatible-mode/v1
# 默认对话模型
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0
# 视觉语言模型（图片理解）
VL_MODEL=qwen3-vl-flash
# 商品名识别 / 知识图谱抽取使用的模型
ITEM_MODEL=qwen-flash
KG_MODEL=qwen-flash

# ---------- Embedding / Rerank ----------
EMBEDDING_MODEL=qwen3.7-text-embedding
# BGE-M3 与 reranker 运行设备：cuda / cpu
BGE_DEVICE=cpu
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_PATH=BAAI/bge-reranker-v2-m3
# 重排序分数阈值（低于阈值的结果会被过滤）
RERANK_GAP_ABS=0.05
RERANK_GAP_RATIO=0.1

# ---------- Neo4j 图数据库（知识图谱）----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ---------- Milvus 向量库 ----------
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names_v2
ENTITY_NAME_COLLECTION=kb_entity_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.3

# ---------- MongoDB（会话历史）----------
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kb001

# ---------- MinIO（图片/文件对象存储）----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=your-bucket

# ---------- MCP ----------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 模型缓存 / 离线 ----------
HF_HOME=./model_cache
MODELSCOPE_CACHE=./model_cache
MODELSCOPE_OFFLINE=0
MINERU_MODEL_SOURCE=modelscope
