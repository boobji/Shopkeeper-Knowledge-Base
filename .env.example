# ==========================================================
# 配置模板：复制本文件为 knowledge/.env 后填入你自己的值
#     cp .env.example knowledge/.env
# 注意：knowledge/.env 已被 .gitignore 忽略，不会提交到仓库
# ==========================================================

# ---------- LLM 大模型 ----------
# OpenAI 兼容端点（可填阿里百炼 / DeepSeek / 本地 vLLM 等）
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://your-endpoint/compatible-mode/v1
# 默认对话模型
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0
# 视觉语言模型（图片理解）
VL_MODEL=qwen3-vl-flash
# 商品名识别 / 知识图谱抽取使用的模型
ITEM_MODEL=qwen-flash
KG_MODEL=qwen-flash

# ---------- Embedding / Rerank（均为本地模型，详见 README「本地模型组件」）----------
# 注：嵌入由本地 BGE-M3 完成，无需云端 embedding 配置
# BGE-M3 与 reranker 运行设备：cuda / cpu
BGE_DEVICE=cpu
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_PATH=BAAI/bge-reranker-v2-m3
# 重排序分数阈值（低于阈值的结果会被过滤）
RERANK_GAP_ABS=0.05
RERANK_GAP_RATIO=0.1

# ==================== 查询流程（意图路由/澄清/质量门控） ====================
# 意图路由开关（关闭后所有问题都走原全流程）
INTENT_ROUTE_ENABLED=1
# 澄清最多追问轮数，超过后降级为"请提供完整型号"
CLARIFY_MAX_TURNS=2
# 检索质量门控：top1 分数低于置信下限 → 坦诚兜底不强行作答（bge-reranker-v2-m3 分数量纲约 -11 ~ +5）
ANSWER_CONFIDENCE_FLOOR=0.0
# top1 分数低于提示阈值 → 答案附"仅供参考"提示
ANSWER_WARN_SCORE=2.0

# ---------- Neo4j 图数据库（知识图谱）----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ---------- Milvus 向量库 ----------
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names_v2
ENTITY_NAME_COLLECTION=kb_entity_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.3

# ---------- MongoDB（会话历史）----------
# 用 docker-compose.yml 启动的容器默认映射到 27018（避开本机 MongoDB 的 27017）
# 若本机已装 MongoDB 并打算直接用它，改回 mongodb://localhost:27017 即可
MONGO_URL=mongodb://localhost:27018
MONGO_DB_NAME=kb001

# ---------- MinIO（图片/文件对象存储）----------
# 用 docker-compose.yml 启动时，账号密码即 compose 里的默认值：
#   MINIO_ACCESS_KEY=minioadmin
#   MINIO_SECRET_KEY=minioadmin
#   MINIO_BUCKET_NAME=shopkeeper-kb   （容器启动时已自动建桶并设为公开读）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=shopkeeper-kb

# ---------- MCP ----------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 模型缓存 / 离线 ----------
HF_HOME=./model_cache
MODELSCOPE_CACHE=./model_cache
MODELSCOPE_OFFLINE=0
MINERU_MODEL_SOURCE=modelscope

# ---------- 切片与索引优化 ----------
# 长章节二次切分的相邻重叠字符数（0=关闭；建议 max_content_length 的 10% 左右）
CHUNK_OVERLAP=200
# Contextual Retrieval：入库前用 LLM 为每个 chunk 生成上下文前缀并参与向量化（1=开）
CONTEXTUAL_RETRIEVAL=1
CONTEXTUAL_MAX_WORKERS=4
CONTEXTUAL_TIMEOUT=30
# Parent-Child 索引：检索子块（小块高精度）、返回父块（大块足上下文）（1=开）
PARENT_CHILD_ENABLED=1
CHILD_CHUNKS_COLLECTION=kb_child_chunks
CHILD_CHUNK_SIZE=450
CHILD_CHUNK_OVERLAP=80

# ---------- 结构还原（P0-1）----------
# 扫描件 OCR 后常丢失 Markdown 的 # 标题，导致切块退化成按字数硬切。
# 开启后，标题稀疏时改用 MinerU 中间产物 *_content_list.json 的 text_level 还原层级（1=开）
STRUCTURE_AWARE_ENABLED=1
# 硬切率超过该阈值才判定为"结构缺失"并触发还原（0~1）
STRUCTURE_HARD_SPLIT_THRESHOLD=0.30

# ---------- 切片清洗（P0-2 / P0-3）----------
CHUNK_CLEAN_ENABLED=1
# 中文占非空字符比例：低于 CHUNK_DROP_ZH_RATIO 直接丢弃（外文页/纯符号页）
CHUNK_DROP_ZH_RATIO=0.05
# 介于两者之间 → 保留但标记 lang=mixed，供检索侧降权
# 注意：规格表、参数表里单位符号多，中文占比天然偏低，调高此值会误伤技术页
CHUNK_MIN_ZH_RATIO=0.20
# 丢弃目录/索引页（连续点线引导符）（1=开）
CHUNK_DROP_TOC=1
# 通用样板段去重：跨文档重复出现的安全声明/免责条款（沿用 n-gram 相似度，不调用模型）
CHUNK_BOILERPLATE_ENABLED=1
CHUNK_BOILERPLATE_THRESHOLD=0.60
# 至少在多少个不同文档中出现过才认定为通用样板段（调大=更保守）
CHUNK_BOILERPLATE_MIN_DOCS=2
# 样板段指纹库落盘位置，留空则写到 knowledge/temp_data/boilerplate_fingerprints.json
BOILERPLATE_STORE_PATH=

# ---------- LLM 调用留档 ----------
# 把每次发给 LLM/VLM 的完整提示词与响应落盘（导入: 任务目录下 llm_calls/；问答: temp_data/llm_logs/日期/任务ID/）
LLM_CALL_LOG_ENABLED=1
# 留档根目录（问答流程用），留空则默认 knowledge/temp_data/llm_logs
LLM_CALL_LOG_DIR=
